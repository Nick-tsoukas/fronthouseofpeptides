# ── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Strapi ───────────────────────────────────────────────────────────────
# Production: https://api.quantumbiopeptides.com
STRAPI_URL=http://localhost:1337

# Full-access API token — generate in Strapi admin → Settings → API Tokens
# NEVER expose this to the browser (server-only via runtimeConfig.strapiToken)
STRAPI_TOKEN=your_strapi_full_access_api_token_here

# ── SMTP / Email (Brevo) ──────────────────────────────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Sender shown on customer and owner emails — must be a verified Brevo sender
ORDER_FROM_EMAIL=Quantum Bio Peptides <orders@quantumbiopeptides.com>

# Internal address that receives new order request notifications
OWNER_ORDER_EMAIL=

# ── Owner Admin Auth ──────────────────────────────────────────────────────
# Password for the owner dashboard login (/owner/login)
OWNER_ADMIN_PASSWORD=

# Secret used to sign the owner session cookie — use openssl rand -base64 32
OWNER_SESSION_SECRET=

# ── Owner Web Push (PWA) ─────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
# Public key is safe in the browser. Private key is server-only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:orders@quantumbiopeptides.com

# ── Stripe ───────────────────────────────────────────────────────────────
# Parked — do not use until a compliant payment processor is selected.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── App ───────────────────────────────────────────────────────────────────
# Production: https://quantumbiopeptides.com
# Used for Moov OAuth Origin header and absolute URLs (also exposed as public.appUrl)
# Moov card Drops require HTTPS — http://localhost will be blocked by cards.moov.io CSP.
# For local Moov testing, use an HTTPS tunnel and set APP_URL to that https:// origin.
APP_URL=http://localhost:3000

# ── Moov (server-only) ────────────────────────────────────────────────────
# All Moov credentials stay in private runtimeConfig — never runtimeConfig.public.
# Do NOT use legacy names PUBLIC_MOOV / SECRET_MOOV.
MOOV_PUBLIC_KEY=
MOOV_SECRET_KEY=
MOOV_ACCOUNT_ID=
MOOV_MODE=test
MOOV_WEBHOOK_SECRET=

# ── Shippo (server-only) ──────────────────────────────────────────────────
# API token stays in private runtimeConfig — never runtimeConfig.public.
# Do NOT use legacy name SHIPPO_TEST.
SHIPPO_API_TOKEN=
SHIPPO_MODE=test
# Comma-separated carriers shown at checkout (default: usps). Example: usps,ups
# When set, this overrides Store Settings allowed carriers.
SHIPPO_ALLOWED_CARRIERS=usps

# Ship-from address used for all shipments.
# If these are empty, Store Settings ship-from values in admin are used as fallback.
SHIPPING_FROM_NAME=
SHIPPING_FROM_COMPANY=
SHIPPING_FROM_STREET1=
SHIPPING_FROM_STREET2=
SHIPPING_FROM_CITY=
SHIPPING_FROM_STATE=
SHIPPING_FROM_ZIP=
SHIPPING_FROM_COUNTRY=US
SHIPPING_FROM_PHONE=
SHIPPING_FROM_EMAIL=

# Default parcel dimensions and weight
DEFAULT_PARCEL_LENGTH_IN=6
DEFAULT_PARCEL_WIDTH_IN=4
DEFAULT_PARCEL_HEIGHT_IN=2
DEFAULT_PARCEL_WEIGHT_OZ=6
